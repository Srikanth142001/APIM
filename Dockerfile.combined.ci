# ═══════════════════════════════════════════════════════════════════════════════
# NexGen APIM — Combined Container (CI/CD Build from Source)
# Includes: React frontend + Node.js backend + Grafana
#
# Build:
#   docker build -f Dockerfile.combined.ci -t reddy321678/apim:latest .
#
# Run:
#   docker run -d -p 8082:80 \
#     -e APP_INSIGHTS_APP_ID=xxx \
#     -e APP_INSIGHTS_API_KEY=xxx \
#     -e JWT_SECRET=xxx \
#     -e ADMIN_PASSWORD=xxx \
#     reddy321678/apim:latest
#
# Grafana: http://your-host:8082/grafana  (admin / admin)
# ═══════════════════════════════════════════════════════════════════════════════

# ── Stage 1: Build Frontend ───────────────────────────────────────────────────
FROM node:18-alpine AS frontend-builder

WORKDIR /build
COPY app-insights-dashboard/package*.json ./
RUN npm ci --only=production
COPY app-insights-dashboard/ ./
RUN npm run build

# ── Stage 2: Prepare Backend ──────────────────────────────────────────────────
FROM node:18-alpine AS backend-builder

WORKDIR /build
COPY app-insights-backend/package*.json ./
RUN npm ci --only=production
COPY app-insights-backend/ ./

# ── Stage 3: Combined Runtime Image ───────────────────────────────────────────
# Use full Debian Bookworm node image — required for Grafana glibc binary
# and for apt packages like supervisor, nginx, curl to be available
FROM node:18-bookworm-slim

LABEL maintainer="NexGen APIM Team"
LABEL description="NexGen APIM — Combined single container (frontend + backend + grafana)"

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
        nginx \
        supervisor \
        gettext-base \
        curl \
        ca-certificates \
        postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# ── Install Grafana OSS ───────────────────────────────────────────────────────
RUN GRAFANA_VERSION="11.1.4" && \
    curl -fsSL "https://dl.grafana.com/oss/release/grafana-${GRAFANA_VERSION}.linux-amd64.tar.gz" \
        -o /tmp/grafana.tar.gz && \
    tar -xzf /tmp/grafana.tar.gz -C /opt && \
    # Handle "grafana-11.x.x" OR "grafana-v11.x.x" extraction dir names
    GRAFANA_DIR=$(ls /opt | grep -E "^grafana" | head -1) && \
    mv /opt/${GRAFANA_DIR} /opt/grafana && \
    rm /tmp/grafana.tar.gz && \
    mkdir -p /var/lib/grafana \
             /var/log/grafana \
             /etc/grafana/provisioning/datasources \
             /etc/grafana/provisioning/dashboards

# ── Grafana config ────────────────────────────────────────────────────────────
RUN cat > /etc/grafana/grafana.ini <<'GRAFANA_INI'
[server]
http_port = 3000
root_url = %(protocol)s://%(domain)s/grafana/
serve_from_sub_path = true

[security]
admin_user = admin
admin_password = admin
allow_embedding = true
cookie_samesite = disabled

[auth.anonymous]
enabled = true
org_name = Main Org.
org_role = Viewer
hide_version = false

[auth]
disable_login_form = false

[log]
mode = console
level = warn
GRAFANA_INI

# ── Copy backend ──────────────────────────────────────────────────────────────
WORKDIR /app/backend
COPY --from=backend-builder /build /app/backend
RUN rm -f /app/backend/.env

# ── Copy frontend build ───────────────────────────────────────────────────────
COPY --from=frontend-builder /build/build /usr/share/nginx/html

# ── nginx config (Debian path: /etc/nginx/sites-enabled/) ────────────────────
RUN rm -f /etc/nginx/sites-enabled/default && \
    cat > /etc/nginx/sites-enabled/default <<'NGINX_CONF'
server {
    listen 80;
    listen [::]:80;
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 10M;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml;
    gzip_min_length 1024;

    add_header X-Content-Type-Options "nosniff" always;

    # ── Backend API ──────────────────────────────────────────────────────────
    location ~ ^/api/ {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 180s;
        proxy_connect_timeout 10s;
        proxy_buffering off;
        proxy_request_buffering off;
    }

    # ── Grafana ──────────────────────────────────────────────────────────────
    location /grafana/ {
        proxy_pass http://127.0.0.1:3000/grafana/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 300s;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Content-Security-Policy;
        add_header X-Frame-Options "ALLOWALL";
    }

    # ── React SPA ────────────────────────────────────────────────────────────
    location / {
        add_header X-Frame-Options "SAMEORIGIN" always;
        try_files $uri $uri/ /index.html;
    }

    location ~* (index\.html|config\.js)$ {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        expires 0;
    }

    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    location /health {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }

    error_page 404 /index.html;
}
NGINX_CONF

# ── supervisord config ────────────────────────────────────────────────────────
RUN cat > /etc/supervisor/conf.d/nexgen.conf <<'SUPERVISORD_CONF'
[supervisord]
nodaemon=true
logfile=/var/log/supervisor/supervisord.log
pidfile=/var/run/supervisord.pid
loglevel=info

[program:backend]
command=node /app/backend/index.js
directory=/app/backend
autostart=true
autorestart=true
startretries=5
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
stderr_logfile=/dev/stderr
stderr_logfile_maxbytes=0
environment=PORT="5000",NODE_ENV="production"

[program:nginx]
command=/usr/sbin/nginx -g "daemon off;"
autostart=true
autorestart=true
startretries=3
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
stderr_logfile=/dev/stderr
stderr_logfile_maxbytes=0

[program:grafana]
command=/opt/grafana/bin/grafana server --config /etc/grafana/grafana.ini --homepath /opt/grafana
directory=/opt/grafana
autostart=true
autorestart=true
startretries=3
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
stderr_logfile=/dev/stderr
stderr_logfile_maxbytes=0
environment=GF_PATHS_DATA="/var/lib/grafana",GF_PATHS_LOGS="/var/log/grafana",GF_PATHS_PLUGINS="/var/lib/grafana/plugins",GF_PATHS_PROVISIONING="/etc/grafana/provisioning"
SUPERVISORD_CONF

# ── Entrypoint ────────────────────────────────────────────────────────────────
COPY combined-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

RUN mkdir -p /app/shared /var/log/supervisor

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD curl -f http://localhost/health || exit 1

ENTRYPOINT ["/entrypoint.sh"]
